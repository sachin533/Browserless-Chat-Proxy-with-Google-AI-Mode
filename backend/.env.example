# ---------------------------------------------------------------------------
# Google AI Mode API - backend environment
# Copy this file to `.env` and adjust the values.
# The `.env` file is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Service metadata ------------------------------------------------------
APP_NAME="Google AI Mode API"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- HTTP server ------------------------------------------------------------
# Use 0.0.0.0 only when the backend must be reachable from another machine.
HOST=127.0.0.1
PORT=8000
# Set when the app is served behind a reverse proxy under a sub path.
# ROOT_PATH=

# --- Security ---------------------------------------------------------------
# Shared secret used by the Chrome extension to authenticate over the
# WebSocket.  If it is left empty a strong random token is generated on the
# first start and written back into this file.
EXTENSION_PAIRING_TOKEN=
AUTO_GENERATE_PAIRING_TOKEN=true

# Optional REST API keys (comma separated).  When REQUIRE_API_KEY=true every
# /v1 request must send one of these keys via `X-API-Key` or a Bearer token.
API_KEYS=
REQUIRE_API_KEY=false

# Keep false in production: the pairing token must travel over TLS/WSS.
ALLOW_INSECURE_TRANSPORT=true

# --- CORS -------------------------------------------------------------------
# Comma separated list of allowed browser origins.
# 3000 = the frontend dev server of an alternative setup, 5173 = Vite default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false

# --- Request handling -------------------------------------------------------
# Maximum time (seconds) a single browser interaction may take.
REQUEST_TIMEOUT_SECONDS=180
# How long a request may wait for the browser session to become free.
QUEUE_WAIT_TIMEOUT_SECONDS=60
# The AI Mode tab is a single shared resource - keep this at 1.
MAX_CONCURRENT_REQUESTS=1
MAX_PENDING_REQUESTS=20
MAX_PROMPT_CHARS=8000
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Google AI Mode behaviour ----------------------------------------------
# Model identifiers accepted by /v1/chat/completions.
SUPPORTED_MODELS=google-ai-mode,ai-mode,google-ai,gemini,gpt-4o-mini,gpt-4o
# Start a brand new AI Mode conversation for every request so answers never
# inherit earlier context.
RESET_CONVERSATION_PER_REQUEST=true
