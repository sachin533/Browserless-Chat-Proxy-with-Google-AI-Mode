# ---------------------------------------------------------------------------
# Frontend environment configuration.
# Copy this file to `.env` (or `.env.local`) and adjust the values.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend that serves the Google AI Mode API.
# The backend must allow this origin via CORS (CORS_ORIGINS in backend/.env).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Model name sent in the chat completion request.
# Must be one of the backend's SUPPORTED_MODELS.
VITE_MODEL=google-ai-mode

# Poll interval (ms) for /health and /api/extension/status.
VITE_STATUS_POLL_MS=5000

# Set to "false" to disable Server-Sent Events and always use plain requests.
VITE_ENABLE_STREAMING=true
